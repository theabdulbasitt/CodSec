# Free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# The model the agent reasons with. Primary tool-caller / lightweight fallback:
#   qwen/qwen3-coder:free   |   z-ai/glm-4.5-air:free
AGENT_MODEL=qwen/qwen3-coder:free

# Where the target is reachable. Agent REFUSES any host not on the local allow-list.
TARGET_BASE_URL=http://localhost:8001