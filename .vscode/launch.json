{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Agent (tsx)",
            "type": "node",
            "request": "launch",
            "runtimeArgs": [
                "--import",
                "tsx"
            ],
            "args": [
                "${workspaceFolder}/agent/index.ts"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}
